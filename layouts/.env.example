# Copy to .env.local (gitignored) for local development. Every VITE_ value ends up in the browser bundle.

# Google Maps JavaScript API key. Restrict it by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID with vector rendering (tilt, rotation, WebGL overlay). Without one Google's DEMO_MAP_ID is used.
VITE_GOOGLE_MAP_ID=

# Supabase project URL and its publishable (anon) key. RLS lets this key read only public columns of published projects.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Where the app is served. GitHub Pages: /gip-platform/layouts/  (default /)
VITE_BASE=
# The marketing website, for "A project by Greater Infra Projects" and footer links.
VITE_WEBSITE_URL=https://gjagadish123.github.io/gip-platform/site/
