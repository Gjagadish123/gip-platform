# Copy to .env.local. Values: Supabase dashboard > Project Settings > API (or `npx supabase status` for local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The live layouts app (gip-platform/layouts, a separate site) that "Live layouts" and the mapped projects' cards open,
# with ?project=<id>. Unset: the GitHub Pages copy. Locally: http://127.0.0.1:4030/
NEXT_PUBLIC_LAYOUTS_URL=
