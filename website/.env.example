# Copy to .env.local. Values: Supabase dashboard > Project Settings > API (or `npx supabase status` for local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Maps JavaScript API key for /layouts (map, nearby places, drive routes). It ships to the browser by design:
# restrict it in Google Cloud to your site's HTTP referrers and to Maps JavaScript API, Places API (New) and Routes API.
# Without it /layouts shows the approved layouts as a plan, without the map or nearby places.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
