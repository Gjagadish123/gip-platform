# Copy to .env.local. Local values: `npm run db:start` (repo root) prints both. Hosted: Dashboard > Project Settings > API.
# Leave both unset for the browser-only demo (what the GitHub Pages preview builds).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The live layouts app (gip-platform/layouts), for the "Live layout ↗" links on the four mapped projects: opened as
# <url>?project=<id>. Unset: the GitHub Pages copy. Locally: http://127.0.0.1:4030/
NEXT_PUBLIC_LAYOUTS_URL=
