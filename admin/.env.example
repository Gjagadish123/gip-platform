# Copy to .env.local. Local values: `npm run db:start` (repo root) prints both. Hosted: Dashboard > Project Settings > API.
# Leave both unset for the browser-only demo (what the GitHub Pages preview builds).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The public website, for the inventory's "Live layout ↗" link on the four mapped projects (e.g. http://localhost:3000).
NEXT_PUBLIC_WEBSITE_URL=
