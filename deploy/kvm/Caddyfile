# Caddy on the KVM server (/etc/caddy/Caddyfile). Each named site gets its HTTPS certificate (and renewals) on its own
# while its DNS points here. The website's address is www (SITE_URL); the bare domain and the server's address forward
# to it. The admin is never indexed.

(headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

www.greaterinfraprojects.in {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
	import headers
}

admin.greaterinfraprojects.in {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
	import headers
	header X-Robots-Tag "noindex, nofollow"
}

greaterinfraprojects.in {
	redir https://www.greaterinfraprojects.in{uri} permanent
}

http://189.72.149.6 {
	redir https://www.greaterinfraprojects.in{uri} permanent
}
