# Caddy on the KVM server (/etc/caddy/Caddyfile). Each named site gets its HTTPS certificate (and renewals) on its own
# while its DNS points here. The website's address is www (SITE_URL); the bare domain and the server's address forward
# to it. The admin is never indexed.

(headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}

www.greaterinfraprojects.in {
	encode zstd gzip
	import headers
	# The live layouts app (static, built with VITE_BASE=/layouts/).
	redir /layouts /layouts/ permanent
	handle_path /layouts/* {
		root * /var/www/gip-layouts
		try_files {path} /index.html
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

admin.greaterinfraprojects.in {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
	import headers
	header X-Robots-Tag "noindex, nofollow"
}

# Self-hosted Supabase (deploy/kvm/supabase): Caddy does the gateway's routing and CORS (any origin, no cookies, as on
# hosted Supabase). The services check the JWTs themselves. `route` keeps the order: preflights first.
api.greaterinfraprojects.in {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
		>Access-Control-Allow-Origin "*"
		>Access-Control-Expose-Headers "Content-Range, Content-Profile, Preference-Applied, X-Supabase-Api-Version, sb-error-code, Content-Length, Content-Type, ETag"
	}
	route {
		@preflight method OPTIONS
		handle @preflight {
			header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD"
			header Access-Control-Allow-Headers "{http.request.header.Access-Control-Request-Headers}"
			header Access-Control-Max-Age "86400"
			respond 204
		}
		# The data API's root lists every table and function; hosted Supabase keeps it to admins.
		respond /rest/v1/ 404
		handle_path /auth/v1/* {
			reverse_proxy 127.0.0.1:9999
		}
		handle_path /rest/v1/* {
			reverse_proxy 127.0.0.1:3100
		}
		handle /realtime/v1/api/* {
			uri strip_prefix /realtime/v1
			reverse_proxy 127.0.0.1:4000 {
				header_up Host realtime-dev.supabase-realtime
			}
		}
		handle /realtime/v1/* {
			uri replace /realtime/v1/ /socket/ 1
			reverse_proxy 127.0.0.1:4000 {
				header_up Host realtime-dev.supabase-realtime
			}
		}
		handle_path /storage/v1/* {
			reverse_proxy 127.0.0.1:5000 {
				header_up X-Forwarded-Prefix /storage/v1
			}
		}
		handle_path /functions/v1/* {
			reverse_proxy 127.0.0.1:9000
		}
		respond 404
	}
}

greaterinfraprojects.in {
	# Browsers that kept the old website (it lived on this address) drop it on their first visit here.
	header Clear-Site-Data "\"cache\""
	header Cache-Control no-store
	redir https://www.greaterinfraprojects.in{uri} permanent
}

http://189.72.149.6 {
	redir https://www.greaterinfraprojects.in{uri} permanent
}
